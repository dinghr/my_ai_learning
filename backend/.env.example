# ============================================================
# AI助学小程序 - 环境配置模板
# 复制为 .env.development / .env.test / .env.production 使用
# 不要在生产服务器上提交真实的 .env.production！
# ============================================================

# 环境标识：development | test | production
env=development

# 数据库（按环境隔离）
# development: sqlite:///./ai_learning_dev.db
# test:        sqlite:///./ai_learning_test.db
# production:  sqlite:///./ai_learning_prod.db  或 PostgreSQL
database_url=sqlite:///./ai_learning.db

# JWT 密钥（生产环境必须修改！）
secret_key=change-this-to-a-random-secret-key-in-production
algorithm=HS256
access_token_expire_days=7

# DeepSeek AI
deepseek_api_key=sk-your-deepseek-api-key
deepseek_base_url=https://api.deepseek.com/v1
deepseek_model=deepseek-chat

# 微信小程序（生产/测试需要填写真实的 appid 和 secret）
# 开发模式留空会自动进入 dev 模式（code 直接当 openid）
wechat_appid=
wechat_secret=

# 阿里云（可选，用于 OCR 等功能）
aliyun_access_key_id=
aliyun_access_key_secret=

# CORS 允许域名（生产环境必须限制）
# development: *
# production:  https://your-domain.com,https://www.your-domain.com
cors_origins=*
